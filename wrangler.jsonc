{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "plain-wind-ae46",
  "main": "worker/index.mjs",
  "compatibility_date": "2026-07-27",
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/health"]
  },
  "observability": {
    "enabled": true
  },
  "vars": {
    "INFINISYNAPSE_API_BASE_URL": "https://app.infinisynapse.cn",
    "LIVE_ANALYSIS_ENABLED": "true",
    "ALLOWED_ORIGINS": "https://plain-wind-ae46.yefuyou2333.workers.dev,http://localhost:5173,http://127.0.0.1:5173",
    "DAILY_LIVE_LIMIT": "10",
    "MAX_INFLIGHT": "1",
    "JUDGE_SESSION_TTL_MINUTES": "360"
  },
  "secrets": {
    "required": [
      "INFINISYNAPSE_API_KEY",
      "JUDGE_ACCESS_CODE",
      "JUDGE_TOKEN_SECRET"
    ]
  },
  "ratelimits": [
    {
      "name": "ANALYSIS_RATE_LIMITER",
      "namespace_id": "940271",
      "simple": {
        "limit": 1,
        "period": 60
      }
    },
    {
      "name": "JUDGE_AUTH_RATE_LIMITER",
      "namespace_id": "940272",
      "simple": {
        "limit": 5,
        "period": 60
      }
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "USAGE_GUARD",
        "class_name": "UsageGuard"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "UsageGuard"
      ]
    }
  ]
}
